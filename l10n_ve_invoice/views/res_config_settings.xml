
<odoo>
    <data>
        <record id="res_config_settings_locve_invoice" model="ir.ui.view">
            <field name="name">res.config.settings.locve.rate</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="l10n_ve_base.res_config_settings_view_form_locve_base"/>
            <field name="arch" type="xml">
                <xpath expr="//app[@name='l10n_ve_base']" position="inside">
                    <h2>Invoice Configuration</h2>
                    <div class="row mt16 o_settings_container" name="invoice_settings">
                        <div class="col-12 col-lg-6 o_setting_box" id="multiple_prices_setting">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <div>
                                    limit the number of lines that can be printed on a free form invoice

                                </div>
                                <field name="max_product_invoice"/>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box" id="show_usd_on_free_form">
                            <div class="o_setting_left_pane">
                                <field name="show_total_on_usd_invoice"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <group colspan="2" col="4">
                                    <label for="show_total_on_usd_invoice"/>
                                </group>
                                <div class="text-muted">
                                   Show Total USD on Free Form Invoice
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box" id="show_tag_usd_on_free_form">
                            <div class="o_setting_left_pane">
                                <field name="show_tag_on_usd_invoice"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <group colspan="2" col="4">
                                    <label for="show_tag_on_usd_invoice"/>
                                </group>
                                <div class="text-muted">
                                   Show Tag USD on Free Form Invoice
                                </div>
                            </div>
                        </div>

                        <!-- Forma Libre Top Margin Setting -->
                        <div class="col-12 col-lg-6 o_setting_box" id="forma_libre_margin_setting">
                            <div class="o_setting_left_pane">
                                <field name="activate_custom_margin"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="activate_custom_margin"/>
                                <div class="text-muted">
                                    Habilitar opción para desplazar el contenido de la factura.
                                </div>
                                <div class="content-group" invisible="not activate_custom_margin">
                                    <div class="mt16">
                                        <label for="forma_libre_top_margin" string="Desplazamiento (cm)"/>
                                        <field name="forma_libre_top_margin" class="o_light_label"/>
                                        <div class="text-muted">
                                            <strong>Ayuda:</strong> El incremento en cm es para bajar el contenido y los cm que agregren es adicionales a la altura actual del contenido no del borde superior de la hoja.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>



                        <div class="col-12 col-lg-4 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="group_sales_invoicing_series" class="oe_inline" required="1"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="group_sales_invoicing_series" />
                                <div class="text-muted">It allow enable the invoicing sequences by series in sale's journals.</div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

        <!-- Configuración de fuente de factura en Ajustes de Contabilidad -->
        <record id="res_config_settings_view_form_inherit_font" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.font</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='venezuela_localization']" position="inside">
                    <setting id="l10n_ve_invoice_font" string="Invoice Font Style" company_dependent="1" help="Configure the font family, font size, and line height for Free Form Invoice reports.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="invoice_font_family" class="col-lg-6 o_light_label" string="Font Family"/>
                                <field name="invoice_font_family"/>
                            </div>
                            <div class="row">
                                <label for="invoice_font_size" class="col-lg-6 o_light_label" string="Font Size (px)"/>
                                <field name="invoice_font_size"/>
                            </div>
                            <div class="row">
                                <label for="invoice_line_height" class="col-lg-6 o_light_label" string="Line Height"/>
                                <field name="invoice_line_height"/>
                            </div>
                        </div>
                    </setting>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
